// Cloudflare Workers 設定。
//
// **部署目標由 Pages 改為 Workers**：OpenNext 的 Cloudflare 轉接器產出的是
// Worker（`.open-next/worker.js`）＋靜態資產綁定，不是 Pages 的目錄產物。
// 現行的 `lorebook` Pages 專案於切換上線後退場。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "lorebook",
  "compatibility_date": "2026-08-05",
  // nodejs_compat：Next.js 的 server runtime 需要 Node API
  // global_fetch_strictly_public：讓 worker 內的 fetch 走公開網路語意，
  //   與 Next.js 對 fetch 的假設一致
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 保留 workers.dev 子網域當備援測試網址。**必須明寫**——一旦設定了 routes，
  // wrangler 預設會把 workers.dev 關掉（部署時只以警告告知），正式網域出問題時
  // 就沒有第二條路可以驗。
  "workers_dev": true,
  // 關閉 Preview URLs：開啟 workers.dev 後 wrangler 會預設一併啟用，
  // 那會讓每次部署都多出一個可公開存取的網址。要驗新版用 workers.dev 就夠。
  "preview_urls": false,
  // 自訂網域。原本掛在 `lorebook` Pages 專案上，切換到 Workers 後改綁這裡。
  // custom_domain 會自動建立 DNS 記錄與憑證；同名網域不能同時綁在 Pages 與
  // Worker 上，所以必須先在 Pages 專案移除才能 deploy 成功。
  "routes": [{ "pattern": "lorebook.code4soul.dev", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
