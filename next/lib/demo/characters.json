[{"abilityScores": {"cha": {"modifier": -1, "proficientSave": true, "score": 8}, "con": {"modifier": 2, "proficientSave": false, "score": 14}, "dex": {"modifier": 0, "proficientSave": false, "score": 10}, "int_": {"modifier": 1, "proficientSave": false, "score": 13}, "str": {"modifier": 1, "proficientSave": false, "score": 12}, "wis": {"modifier": 3, "proficientSave": true, "score": 17}}, "ac": 10, "alignment": "守序善良", "alignmentEn": "Lawful Good", "background": "侍僧", "backgroundEn": "Acolyte", "backstory": "自幼在山腹神殿司晨，被指派隨隊出行，記錄沿途需要照拂的人。", "cantrips": [{"castKind": "action", "castingTime": "1 動作", "concentration": false, "damage": "", "damageType": "", "description": "如火焰般的光輝降臨在你能看見、射程內的一個生物身上。目標必須成功通過一次敏捷豁免檢定，否則受到 1d8 光耀傷害。目標在此豁免中不受半掩蔽與四分之三掩蔽的增益。", "level": 0, "name": "聖焰", "nameEn": "Sacred Flame", "prepared": true, "range": "60呎", "upgrade": ""}, {"castKind": "action", "castingTime": "1 動作", "concentration": false, "damage": "", "damageType": "", "description": "你觸碰一個未被他人穿戴或攜帶、大型或更小的物體。法術結束前，該物體發出 20 呎半徑的明亮光照與額外 20 呎的微光光照。光的顏色由你決定。\n以不透光之物覆蓋該物體可阻擋光芒。若你再次施展本法術，原法術結束。", "level": 0, "name": "光亮術", "nameEn": "Light", "prepared": true, "range": "觸及", "upgrade": ""}, {"castKind": "action", "castingTime": "1 動作", "concentration": true, "damage": "", "damageType": "", "description": "你觸碰一個自願生物並選擇一項技能。法術結束前，該生物使用所選技能進行的任何能力檢定加 1d4。", "level": 0, "name": "神導術", "nameEn": "Guidance", "prepared": true, "range": "觸及", "upgrade": ""}], "className": "牧師", "classNameEn": "Cleric", "concentrationSpell": null, "conditions": [], "creatureType": "Humanoid", "currency": {"cp": 0, "ep": 0, "gp": 0, "pp": 0, "sp": 0}, "currentHp": 11, "deity": "", "deityEn": "", "equipment": [], "exhaustionLevel": 0, "features": [{"description": "你已將自身奉獻給下列自選神聖角色之一。", "name": "神聖職分", "nameEn": "Divine Order", "source": "職業：牧師 Lv1"}, {"description": "你受過戰鬥訓練，獲得type=martial weapon的熟練與type=Heavy Armor的訓練。", "name": "護教軍", "nameEn": "Protector", "source": "職業：牧師 Lv1"}, {"description": "你已學會透過祈禱與冥想施展法術。施法規則見7。以下說明你如何將這些規則用於牧師法術；法術清單見本職業敘述後段的class=Cleric。\n【戲法】\n你從class=Cleric中學會三個自選戲法，建議選擇神導術、聖焰與奇術。\n每當你獲得一個牧師等級，你可以將其中一個戲法替換為class=Cleric中另一個自選戲法。\n當你達到牧師 4 級與 10 級時，你各再從class=Cleric中學會一個自選戲法，見「牧師特性表」的戲法欄。\n【法術位】\n「牧師特性表」列出你用於施展一環以上法術的法術位數量。完成一次長休時回復所有已消耗的法術位。\n【一環以上的準備法術】\n你準備一份可用本特性施展的一環以上法術清單。首先從class=Cleric中選擇四個一環法術，建議選擇祝福術、治療傷勢、光導箭與虔誠護盾。\n清單上的法術數量隨你的牧師等級提升，見「牧師特性表」的準備法術欄。每當該數量增加，從class=Cleric中選擇額外法術，直到清單數量與表中數值相符。所選法術的環位必須是你具有法術位的環位。例如，你若是 3 級牧師，準備法術清單可以包含任意組合的六個一環與二環法術。\n若其他牧師特性給予你永遠視為已準備的法術，這些法術不計入本特性可準備的法術數量，但其餘方面對你而言視為牧師法術。\n【更換準備法術】\n每當你完成一次長休，你可以更換你的準備法術清單，將其中任何法術替換為其他你具有對應法術位的牧師法術。\n【施法屬性】\n感知是你牧師法術的施法屬性。\n【施法法器】\n你可以將聖徽用作牧師法術的施法法器。", "name": "施法", "nameEn": "Spellcasting", "source": "職業：牧師 Lv1"}, {"description": "你額外學會一個class=Cleric中的戲法。此外，你與神聖力量的神秘連結為你的智力（奧秘或宗教）檢定提供加值，數值等同於你的感知調整值（至少 +1）。", "name": "秘術士", "nameEn": "Thaumaturge", "source": "職業：牧師 Lv1"}, {"description": "具毒素傷害抗性，對抗中毒狀態的豁免具優勢。", "name": "矮人韌性", "nameEn": "Dwarven Resilience", "source": "種族：矮人"}, {"description": "生命值上限每個等級 +1。", "name": "矮人堅毅", "nameEn": "Dwarven Toughness", "source": "種族：矮人"}, {"description": "附贈動作獲得 60 呎震顫感知 10 分鐘，每次長休可用熟練加值次數。", "name": "石工直覺", "nameEn": "Stonecunning", "source": "種族：矮人"}, {"description": "120 呎內，昏暗光線視為明亮、黑暗視為昏暗（僅能辨色為灰階）。", "name": "黑暗視覺 120", "nameEn": "Darkvision", "source": "種族：矮人"}, {"description": "你獲得以下增益。\n【兩個戲法】\n你從level=0;1、level=0;1或level=0;1法術列表中學會兩個自選戲法。智力、感知或魅力是你施展本專長法術的施法屬性（在選擇本專長時決定）。\n【一環法術】\n從你為本專長戲法所選的同一列表中選擇一個一環法術。你永遠將該法術視為已準備。你可以免用法術位施展它一次，完成一次長休後回復以此方式施展的能力；你也可以用你擁有的任何法術位施展它。\n【更換法術】\n每當你獲得新的等級，你可以將本專長所選法術之一替換為所選法術列表中同環位的另一個法術。\n【可重複】\n你可以多次選取本專長，但每次必須選擇不同的法術列表。", "name": "法術新手（牧師）", "nameEn": "Magic Initiate", "source": "背景：侍僧"}], "hitDiceUsed": 0, "hitDieFaces": 8, "id": "demo-cleric-001", "initiative": 0, "journalEntries": [], "languages": ["通用語"], "level": 1, "mageArmorActive": false, "maxHp": 11, "name": "布蕾妲・晨鐘", "nameEn": "Bretta Matinbell", "passivePerception": 13, "personality": {"bonds": "山下那間小神殿是我長大的地方，它還在等我回去。", "flaws": "我太容易相信一個人只是走岔了路。", "ideals": "光不必很亮，只要不熄。", "traits": "我在每個天亮時敲一次鐘，即使身邊沒有人聽。"}, "personalityTags": ["溫和", "固執", "守時"], "portraitCenterX": 0.5, "portraitCenterY": 0.5, "portraitScale": 1, "portraitUrl": "", "proficiencyBonus": 2, "resources": [], "size": "Medium", "skills": [{"abilityType": "STR", "modifier": 1, "name": "體能", "nameEn": "Athletics", "proficient": false}, {"abilityType": "DEX", "modifier": 0, "name": "特技", "nameEn": "Acrobatics", "proficient": false}, {"abilityType": "DEX", "modifier": 0, "name": "巧手", "nameEn": "Sleight of Hand", "proficient": false}, {"abilityType": "DEX", "modifier": 0, "name": "隱匿", "nameEn": "Stealth", "proficient": false}, {"abilityType": "INT", "modifier": 1, "name": "奧秘", "nameEn": "Arcana", "proficient": false}, {"abilityType": "INT", "modifier": 1, "name": "歷史", "nameEn": "History", "proficient": false}, {"abilityType": "INT", "modifier": 1, "name": "調查", "nameEn": "Investigation", "proficient": false}, {"abilityType": "INT", "modifier": 1, "name": "自然", "nameEn": "Nature", "proficient": false}, {"abilityType": "INT", "modifier": 3, "name": "宗教", "nameEn": "Religion", "proficient": true}, {"abilityType": "WIS", "modifier": 3, "name": "馴獸", "nameEn": "Animal Handling", "proficient": false}, {"abilityType": "WIS", "modifier": 5, "name": "洞察", "nameEn": "Insight", "proficient": true}, {"abilityType": "WIS", "modifier": 5, "name": "醫藥", "nameEn": "Medicine", "proficient": true}, {"abilityType": "WIS", "modifier": 3, "name": "感知", "nameEn": "Perception", "proficient": false}, {"abilityType": "WIS", "modifier": 3, "name": "求生", "nameEn": "Survival", "proficient": false}, {"abilityType": "CHA", "modifier": -1, "name": "欺瞞", "nameEn": "Deception", "proficient": false}, {"abilityType": "CHA", "modifier": -1, "name": "威嚇", "nameEn": "Intimidation", "proficient": false}, {"abilityType": "CHA", "modifier": -1, "name": "表演", "nameEn": "Performance", "proficient": false}, {"abilityType": "CHA", "modifier": -1, "name": "說服", "nameEn": "Persuasion", "proficient": false}], "species": "矮人", "speciesEn": "Dwarf", "speed": "30ft", "spellAttack": 5, "spellDc": 13, "spellSlots": [{"level": 1, "total": 2, "used": 0}], "spellcastingAbility": "WIS", "spells": [{"castKind": "action", "castingTime": "1 動作", "concentration": false, "damage": "", "damageType": "", "description": "你觸碰的一個生物回復等同於 2d8 加你施法屬性調整值的生命值。", "level": 1, "name": "治療傷勢", "nameEn": "Cure Wounds", "prepared": true, "range": "觸及", "upgrade": ""}, {"castKind": "action", "castingTime": "1 動作", "concentration": true, "damage": "", "damageType": "", "description": "你祝福射程內至多三個生物。受祝目標在法術結束前進行攻擊檢定或豁免檢定時，加上 1d4。", "level": 1, "name": "祝福術", "nameEn": "Bless", "prepared": true, "range": "30呎", "upgrade": ""}, {"castKind": "bonus", "castingTime": "1 附贈動作", "concentration": true, "damage": "", "damageType": "", "description": "一層微光力場環繞射程內由你選擇的一個生物，使其 AC 在持續時間內獲得 +2 加值。", "level": 1, "name": "虔誠護盾", "nameEn": "Shield of Faith", "prepared": true, "range": "60呎", "upgrade": ""}, {"castKind": "action", "castingTime": "1 動作", "concentration": false, "damage": "", "damageType": "", "description": "你向射程內的一個生物擲出一道光矢。對目標進行一次遠端法術攻擊。命中時，目標受到 4d6 光耀傷害，且在你下個回合結束前對其進行的下一次攻擊檢定具有優勢。", "level": 1, "name": "光導箭", "nameEn": "Guiding Bolt", "prepared": true, "range": "120呎", "upgrade": ""}], "subclass": "", "subclassEn": "", "tempHp": 0, "toolProficiencies": ["書法工具"], "weapons": []}, {"abilityScores": {"cha": {"modifier": -1, "proficientSave": false, "score": 8}, "con": {"modifier": 2, "proficientSave": true, "score": 15}, "dex": {"modifier": 1, "proficientSave": false, "score": 13}, "int_": {"modifier": 0, "proficientSave": false, "score": 10}, "str": {"modifier": 3, "proficientSave": true, "score": 17}, "wis": {"modifier": 1, "proficientSave": false, "score": 12}}, "ac": 11, "alignment": "守序善良", "alignmentEn": "Lawful Good", "background": "士兵", "backgroundEn": "Soldier", "backstory": "邊境守備隊出身，退伍後帶著一身舊傷和一把制式長劍上路。", "cantrips": [], "className": "戰士", "classNameEn": "Fighter", "concentrationSpell": null, "conditions": [], "creatureType": "Humanoid", "currency": {"cp": 0, "ep": 0, "gp": 0, "pp": 0, "sp": 0}, "currentHp": 12, "deity": "", "deityEn": "", "equipment": [], "exhaustionLevel": 0, "features": [{"description": "你已磨練出精湛的武藝，獲得一個自選的category=FS，建議選擇防禦。\n每當你獲得一個戰士等級，你可以將所選專長替換為另一個category=FS。", "name": "戰鬥風格", "nameEn": "Fighting Style", "source": "職業：戰士 Lv1"}, {"description": "你體內蓄有一井有限的身心耐力可供汲取。你可以用一個附贈動作回復 1d10 加你戰士等級的生命值。\n你可以使用本特性兩次。完成一次短休時回復一次已消耗的使用次數，完成一次長休時回復全部。\n當你達到特定戰士等級時獲得更多使用次數，見「戰士特性表」的復元氣息欄。", "name": "復元氣息", "nameEn": "Second Wind", "source": "職業：戰士 Lv1"}, {"description": "你的武器訓練使你能使用三種自選type=simple weapon或type=martial weapon的精通屬性。每當你完成一次長休，你可以進行武器操練並更換其中一種武器選擇。\n當你達到特定戰士等級時，你能使用精通屬性的武器種類會增加，見「戰士特性表」的武器精通欄。", "name": "武器精通", "nameEn": "Weapon Mastery", "source": "職業：戰士 Lv1"}, {"description": "每次長休結束時獲得一次英雄激勵。", "name": "足智多謀", "nameEn": "Resourceful", "source": "種族：人類"}, {"description": "任選一項技能獲得熟練。", "name": "多才多藝", "nameEn": "Skillful", "source": "種族：人類"}, {"description": "額外獲得一個起源專長。", "name": "天賦異稟", "nameEn": "Versatile", "source": "種族：人類"}, {"description": "你受過造成致命打擊的訓練。每回合一次，當你以武器命中目標時，你可以將該武器的傷害骰擲兩次，並擇一結果用於該目標。", "name": "野蠻打擊", "nameEn": "Savage Attacker", "source": "背景：士兵"}], "hitDiceUsed": 0, "hitDieFaces": 10, "id": "demo-fighter-001", "initiative": 1, "journalEntries": [], "languages": ["通用語"], "level": 1, "mageArmorActive": false, "maxHp": 12, "name": "洛恩・石盾", "nameEn": "Loen Stoneshield", "passivePerception": 13, "personality": {"bonds": "我的隊伍沒能全員回來，名字我都記著。", "flaws": "面對要動腦的難題，我第一個念頭永遠是硬闖。", "ideals": "守住身後的人，比贏得眼前的仗重要。", "traits": "我用行伍的規矩過日子，起床、擦劍、站哨。"}, "personalityTags": ["可靠", "直率", "念舊"], "portraitCenterX": 0.5, "portraitCenterY": 0.5, "portraitScale": 1, "portraitUrl": "", "proficiencyBonus": 2, "resources": [{"current": 2, "dieFaces": 0, "display": "pips", "max": 2, "name": "第二風", "nameEn": "Second Wind", "recovery": "short", "unit": ""}], "size": "Medium", "skills": [{"abilityType": "STR", "modifier": 5, "name": "體能", "nameEn": "Athletics", "proficient": true}, {"abilityType": "DEX", "modifier": 1, "name": "特技", "nameEn": "Acrobatics", "proficient": false}, {"abilityType": "DEX", "modifier": 1, "name": "巧手", "nameEn": "Sleight of Hand", "proficient": false}, {"abilityType": "DEX", "modifier": 1, "name": "隱匿", "nameEn": "Stealth", "proficient": false}, {"abilityType": "INT", "modifier": 0, "name": "奧秘", "nameEn": "Arcana", "proficient": false}, {"abilityType": "INT", "modifier": 0, "name": "歷史", "nameEn": "History", "proficient": false}, {"abilityType": "INT", "modifier": 0, "name": "調查", "nameEn": "Investigation", "proficient": false}, {"abilityType": "INT", "modifier": 0, "name": "自然", "nameEn": "Nature", "proficient": false}, {"abilityType": "INT", "modifier": 0, "name": "宗教", "nameEn": "Religion", "proficient": false}, {"abilityType": "WIS", "modifier": 1, "name": "馴獸", "nameEn": "Animal Handling", "proficient": false}, {"abilityType": "WIS", "modifier": 1, "name": "洞察", "nameEn": "Insight", "proficient": false}, {"abilityType": "WIS", "modifier": 1, "name": "醫藥", "nameEn": "Medicine", "proficient": false}, {"abilityType": "WIS", "modifier": 3, "name": "感知", "nameEn": "Perception", "proficient": true}, {"abilityType": "WIS", "modifier": 3, "name": "求生", "nameEn": "Survival", "proficient": true}, {"abilityType": "CHA", "modifier": -1, "name": "欺瞞", "nameEn": "Deception", "proficient": false}, {"abilityType": "CHA", "modifier": 1, "name": "威嚇", "nameEn": "Intimidation", "proficient": true}, {"abilityType": "CHA", "modifier": -1, "name": "表演", "nameEn": "Performance", "proficient": false}, {"abilityType": "CHA", "modifier": -1, "name": "說服", "nameEn": "Persuasion", "proficient": false}], "species": "人類", "speciesEn": "Human", "speed": "30ft", "spellAttack": 0, "spellDc": 0, "spellSlots": [], "spellcastingAbility": "", "spells": [], "subclass": "", "subclassEn": "", "tempHp": 0, "toolProficiencies": ["遊戲組"], "weapons": []}, {"abilityScores": {"cha": {"modifier": 0, "proficientSave": false, "score": 10}, "con": {"modifier": 2, "proficientSave": false, "score": 14}, "dex": {"modifier": 3, "proficientSave": true, "score": 17}, "int_": {"modifier": 2, "proficientSave": true, "score": 14}, "str": {"modifier": -1, "proficientSave": false, "score": 8}, "wis": {"modifier": 1, "proficientSave": false, "score": 12}}, "ac": 13, "alignment": "混亂中立", "alignmentEn": "Chaotic Neutral", "background": "罪犯", "backgroundEn": "Criminal", "backstory": "在港都的屋瓦之間長大，靠著身形小、腳步輕活到現在。", "cantrips": [], "className": "盜賊", "classNameEn": "Rogue", "concentrationSpell": null, "conditions": [], "creatureType": "Humanoid", "currency": {"cp": 0, "ep": 0, "gp": 0, "pp": 0, "sp": 0}, "currentHp": 10, "deity": "", "deityEn": "", "equipment": [], "exhaustionLevel": 0, "features": [{"description": "你獲得兩項自選已熟練技能的專精。若你具有巧手與隱匿的熟練，建議選擇它們。\n在盜賊 6 級時，你再獲得兩項自選已熟練技能的專精。", "name": "專精", "nameEn": "Expertise", "source": "職業：盜賊 Lv1"}, {"description": "你在施展盜賊本領的社群中學會了各種語言。你通曉盜賊黑話與另一種自選語言（從2的語言表中選擇）。", "name": "盜賊黑話", "nameEn": "Thieves' Cant", "source": "職業：盜賊 Lv1"}, {"description": "你懂得如何隱蔽出手、利用敵人的分神。每回合一次，若你的攻擊檢定具有優勢且該攻擊使用靈巧或遠端武器，你可以對命中的一個生物額外造成 1d6 傷害，型別與該武器相同。\n若你至少一名盟友在目標 5 呎內、該盟友未處於失能狀態、且你的攻擊檢定不具劣勢，則無需優勢也能造成此傷害。\n額外傷害隨你的盜賊等級提升，見「盜賊特性表」的偷襲欄。", "name": "偷襲", "nameEn": "Sneak Attack", "source": "職業：盜賊 Lv1"}, {"description": "你的武器訓練使你能使用兩種自選、你具熟練的type=simple weapon;martial weapon的精通屬性，例如匕首與短弓。\n每當你完成一次長休，你可以更換所選的武器種類。例如，你可以改為使用彎刀與短劍的精通屬性。", "name": "武器精通", "nameEn": "Weapon Mastery", "source": "職業：盜賊 Lv1"}, {"description": "d20 檢定擲出 1 時可重擲一次，須採用新結果。", "name": "幸運", "nameEn": "Lucky", "source": "種族：半身人"}, {"description": "對抗恐懼的豁免具優勢。", "name": "勇毅", "nameEn": "Brave", "source": "種族：半身人"}, {"description": "可穿越體型比你大的生物所佔空間。", "name": "半身人的靈巧", "nameEn": "Halfling Nimbleness", "source": "種族：半身人"}, {"description": "被體型比你大的生物遮蔽時，仍可嘗試躲藏。", "name": "天生隱匿", "nameEn": "Naturally Stealthy", "source": "種族：半身人"}, {"description": "你獲得以下增益。\n【先攻熟練】\n當你擲先攻時，你可以把你的熟練加值加到擲骰上。\n【先攻互換】\n在你擲先攻後，你可以立即與同場戰鬥中一名自願盟友互換先攻。若你或該盟友處於失能狀態，則不能互換。", "name": "警覺", "nameEn": "Alert", "source": "背景：罪犯"}], "hitDiceUsed": 0, "hitDieFaces": 8, "id": "demo-rogue-001", "initiative": 3, "journalEntries": [], "languages": ["通用語"], "level": 1, "mageArmorActive": false, "maxHp": 10, "name": "琵琶・薊", "nameEn": "Pipa Thistle", "passivePerception": 13, "personality": {"bonds": "我欠碼頭區的老修女一條命，她從沒討過。", "flaws": "看到沒上鎖的東西，手會自己動。", "ideals": "規矩是寫給那些付得起代價的人看的。", "traits": "我從不坐在背對門口的位子。"}, "personalityTags": ["機警", "滑頭", "講義氣"], "portraitCenterX": 0.5, "portraitCenterY": 0.5, "portraitScale": 1, "portraitUrl": "", "proficiencyBonus": 2, "resources": [], "size": "Small", "skills": [{"abilityType": "STR", "modifier": -1, "name": "體能", "nameEn": "Athletics", "proficient": false}, {"abilityType": "DEX", "modifier": 3, "name": "特技", "nameEn": "Acrobatics", "proficient": false}, {"abilityType": "DEX", "modifier": 5, "name": "巧手", "nameEn": "Sleight of Hand", "proficient": true}, {"abilityType": "DEX", "modifier": 5, "name": "隱匿", "nameEn": "Stealth", "proficient": true}, {"abilityType": "INT", "modifier": 2, "name": "奧秘", "nameEn": "Arcana", "proficient": false}, {"abilityType": "INT", "modifier": 2, "name": "歷史", "nameEn": "History", "proficient": false}, {"abilityType": "INT", "modifier": 2, "name": "調查", "nameEn": "Investigation", "proficient": false}, {"abilityType": "INT", "modifier": 2, "name": "自然", "nameEn": "Nature", "proficient": false}, {"abilityType": "INT", "modifier": 2, "name": "宗教", "nameEn": "Religion", "proficient": false}, {"abilityType": "WIS", "modifier": 1, "name": "馴獸", "nameEn": "Animal Handling", "proficient": false}, {"abilityType": "WIS", "modifier": 1, "name": "洞察", "nameEn": "Insight", "proficient": false}, {"abilityType": "WIS", "modifier": 1, "name": "醫藥", "nameEn": "Medicine", "proficient": false}, {"abilityType": "WIS", "modifier": 3, "name": "感知", "nameEn": "Perception", "proficient": true}, {"abilityType": "WIS", "modifier": 1, "name": "求生", "nameEn": "S