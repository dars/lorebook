    {
     "ENG_name": "Attack Advantage",
     "entries": [
      "你對被你{@condition Grappled|XPHB|被擒抱}的生物的攻擊檢定具有{@variantrule Advantage|XPHB|優勢}。"
     ],
     "name": "攻擊優勢",
     "type": "entries"
