# Miscellaneous
*.log
*.swp
.DS_Store
.history

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Environment secrets
#
# .env.json 是已退場的 Flutter 端所用；檔案可能仍留在開發者本機且含 Supabase
# 金鑰，這條保留著避免它變成待提交的未追蹤檔。
.env.json
.env

# Supabase CLI link artifacts
supabase/.temp/

# Cloudflare / Next.js
.wrangler/
next/.dev.vars
next/.open-next/
next/.next/
next/node_modules/
next/.env.local

# 根目錄不該有 node_modules——這裡出現的一律是工具留下的空殼（例如 .vite），
# 不是相依套件；相依裝在 next/ 底下。
/node_modules/
